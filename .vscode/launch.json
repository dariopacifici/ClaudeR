{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Debug API (localhost:5000)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "🔨 build",
      "program": "${workspaceFolder}/Clauder.API/bin/Debug/net10.0/Clauder.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Clauder.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "pattern": "Now listening on:\\s+http://localhost:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      }
    },
    {
      "name": "🔍 Debug API (Attach)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "🐳 Debug API (Docker)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "🐳 docker-up (local HTTPS test)",
      "program": "${workspaceFolder}/Clauder.API/bin/Debug/net10.0/Clauder.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Clauder.API",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5000"
      }
    }
  ],
  "compounds": []
}
